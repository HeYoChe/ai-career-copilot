# 复制为 .env 后填写自己的 Key（不填也能用，只是没有 AI 增强功能）

# 仅 AI 功能需要；基础模式（匹配度 / 缺口 / 面试题模板）无需填写
OPENAI_API_KEY=

# 可选：OpenAI 兼容接口地址（DeepSeek / 通义 / Moonshot / 本地 vLLM 等）
# 例：https://api.deepseek.com/v1
OPENAI_BASE_URL=

# 可选：模型名（默认 gpt-4o-mini）
# 例：deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# 可选：embedding 模型（默认 all-MiniLM-L6-v2；中文简历建议换成多语言模型）
EMBED_MODEL=all-MiniLM-L6-v2
